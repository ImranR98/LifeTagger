# Media library (on the server). Also configurable from the setup screen.
MEDIA_ROOT=/path/to/your/media
# Only allow setup to choose these roots. In the container this is /media.
ALLOWED_MEDIA_ROOTS=
# Extensions to ignore even if they are in the media allowlist.
EXCLUDE_EXT=txt,pp3,json,xmp,aae,db,ini,log
# Add unusual formats without editing the built-in allowlist.
EXTRA_IMAGE_EXT=
EXTRA_VIDEO_EXT=

# Runtime state: SQLite, thumbnails, previews, models, backups, DB snapshots.
DATA_DIR=.lifetagger

# Web push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public origin used by notifications (the Authelia-protected HTTPS hostname in production).
PUBLIC_URL=http://localhost:8080
PORT=8080
HOST=0.0.0.0
TZ=America/Toronto

# Daily review loop.
DAILY_GOAL=15
SUGGEST_RADIUS_M=200

# Local face recognition. Models are bundled with the server package.
FACE_ENABLED=true
# on-demand (recommended for 10k+ files) or background
FACE_SCAN_MODE=on-demand
FACE_MIN_CONFIDENCE=0.5
FACE_MATCH_THRESHOLD=0.55

# Preview sizes and indexing cadence.
PREVIEW_MAX_PX=2048
THUMB_PX=480
INDEX_INTERVAL_MIN=30
INDEX_CONCURRENCY=4
# FFMPEG_PATH=ffmpeg
LOG_LEVEL=info
